  {
    "plugin_id": "herdr-bar",
    "name": "Bar",
    "version": "0.8.0",
    "min_herdr_version": "0.9.0",
    "description": "Cmd+K command bar with agent icons, fuzzy search, and optional automatic tab titles",
    "manifest_path": "/Users/ly/.config/herdr/plugins/github/herdr-bar-96eebe452a9c/herdr-plugin.toml",
    "plugin_root": "/Users/ly/.config/herdr/plugins/github/herdr-bar-96eebe452a9c",
    "enabled": true,
    "platforms": ["linux", "macos", "windows"],
    "startup": [
      {
        "command": ["python3", "run.py", "--start-titles"]
      }
    ],
    "actions": [
      {
        "id": "open",
        "title": "Open bar",
        "description": "Fuzzy-jump to any tab, pane, or agent",
        "contexts": ["global"],
        "platforms": ["linux", "macos"],
        "command": [
          "sh",
          "-c",
          "herdr_bin=\"${HERDR_BIN_PATH:-herdr}\"; [ -x \"$herdr_bin\" ] || herdr_bin=herdr; exec \"$herdr_bin\" plugin pane open --plugin herdr-bar --entrypoint bar --placement popup"
        ]
      },
      {
        "id": "open-windows",
        "title": "Open bar",
        "description": "Fuzzy-jump to any tab, pane, or agent",
        "contexts": ["global"],
        "platforms": ["windows"],
        "command": ["python3", "run.py", "--open"]
      },
      {
        "id": "start-titles",
        "title": "Start tab watcher",
        "description": "Start task title and tab status updates enabled in the plugin config",
        "contexts": ["global"],
        "command": ["python3", "run.py", "--start-titles", "--resume"]
      },
      {
        "id": "stop-titles",
        "title": "Stop tab watcher",
        "description": "Stop this server's title and status watcher, restoring bare tab names",
        "contexts": ["global"],
        "command": ["python3", "run.py", "--stop-titles"]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": ["python3", "run.py", "--start-titles"]
      }
    ],
    "panes": [
      {
        "id": "bar",
        "title": "Bar",
        "description": "Fuzzy-jump to any tab, pane, or agent",
        "placement": "popup",
        "width": "74%",
        "height": "62%",
        "command": ["python3", "run.py"]
      }
    ],
